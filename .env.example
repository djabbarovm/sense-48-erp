# Скопируй в .env и заполни. Никаких значений секретов в git (docs/11-security.md).
DATABASE_URL=postgresql://finance:finance@localhost:5432/finance_os
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=finance-os
SMTP_HOST=localhost
SMTP_PORT=1025
# AES-256-GCM ключ для account_encrypted (32 байта, base64). Генерация: openssl rand -base64 32
BANK_DATA_KEY=
# Dev auth (ADR-002): секрет подписи JWT в dev-режиме
AUTH_JWT_SECRET=
# Telegram bot (Phase D)
TELEGRAM_BOT_TOKEN=
