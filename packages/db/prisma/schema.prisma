model Commission {
  id                 String           @id @default(uuid(7)) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  number             String // CM-2026-000001
  dealId             String           @unique @map("deal_id") @db.Uuid
  unitId             String?          @map("unit_id") @db.Uuid
  product            DealProduct
  payer              CommissionPayer
  payerName          String           @map("payer_name") // арендатор/продавец/собственник — отображаемое имя
  baseMinor          BigInt           @map("base_minor")
  rateBp             Int              @map("rate_bp")
  amountMinor        BigInt           @map("amount_minor")
