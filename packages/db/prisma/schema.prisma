  signedAt         DateTime?     @map("signed_at") @db.Date
  startAt          DateTime?     @map("start_at") @db.Date
  endAt            DateTime?     @map("end_at") @db.Date
  terminatedAt     DateTime?     @map("terminated_at")
  terminatedReason String?       @map("terminated_reason")
  notes            String?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  createdBy        String?       @map("created_by") @db.Uuid
  updatedBy        String?       @map("updated_by") @db.Uuid

  unit  Unit          @relation(fields: [unitId], references: [id])
  owner PropertyOwner @relation(fields: [ownerId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, unitId, status])
  @@map("mall_mandate")
}

