enum MandateStatus {
  DRAFT
  SIGNED
  ACTIVE
  TERMINATED
}

/** ДДУ — мандат собственника помещения ТРЦ на коммерческое управление (Mall §2A, §3). */
model MallMandate {
  id               String        @id @default(uuid(7)) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  unitId           String        @map("unit_id") @db.Uuid
  ownerId          String        @map("owner_id") @db.Uuid
  status           MandateStatus @default(DRAFT)
  /** Регулярное вознаграждение, б.п. от собранной аренды; null — не утверждено (OPEN). */
  feeBp            Int?          @map("fee_bp")
  /** Success fee за сдачу — месяцев аренды (0.5 / 1); null — OPEN. */
  successFeeMonths Decimal?      @map("success_fee_months") @db.Decimal(4, 2)
