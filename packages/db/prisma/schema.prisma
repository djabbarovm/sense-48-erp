  categoryId     String   @map("category_id") @db.Uuid
  accountCode    String   @map("account_code")
  vatAccountCode String?  @map("vat_account_code")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, categoryId])
  @@map("account_mapping")
}

// F-01: налоговый календарь (docs/02 §6)
enum TaxBase {
  TURNOVER
  PAYROLL
}

enum TaxType {
  VAT
  PROFIT
  PAYROLL_TAX
  SOCIAL
  PROPERTY
  OTHER
}

enum TaxObligationStatus {
  PLANNED
  CALCULATED
  APPROVED
  PAID
  FILED
  OVERDUE
}

model TaxCalendarRule {
  id                String   @id @default(uuid(7)) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  type              TaxType
  name              String
  // recurrence: MONTHLY | QUARTERLY | YEARLY (docs/02: cron-like "monthly day 20")
  recurrence        String   @default("MONTHLY")
  dueDay            Int      @map("due_day")
  expectedMinMinor  BigInt?  @map("expected_min_minor")
  expectedMaxMinor  BigInt?  @map("expected_max_minor")
  ownerId           String?  @map("owner_id") @db.Uuid
  // H-10: ставка и база для оценки ожидаемой суммы (TURNOVER — выручка периода, PAYROLL — ФОТ ведомости периода)
  rateBp            Int?     @map("rate_bp")
  baseKind          TaxBase? @map("base_kind")
  note              String?
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("tax_calendar_rule")
}

model TaxObligation {
  id               String              @id @default(uuid(7)) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  type             TaxType
  name             String              @default("")
  period           String // YYYY-MM или YYYY-Qn
  dueDate          DateTime            @map("due_date") @db.Date
  expectedMinMinor BigInt?             @map("expected_min_minor")
  expectedMaxMinor BigInt?             @map("expected_max_minor")
  calculatedMinor  BigInt?             @map("calculated_minor")
  baseMinor        BigInt?             @map("base_minor") // база оценки (ФОТ / выручка периода) на момент генерации
  ownerId          String?             @map("owner_id") @db.Uuid
  paymentRequestId String?             @map("payment_request_id") @db.Uuid
  filedAt          DateTime?           @map("filed_at")
  status           TaxObligationStatus @default(PLANNED)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  updatedBy        String?             @map("updated_by") @db.Uuid

  @@unique([tenantId, type, period])
  @@index([tenantId, status])
  @@map("tax_obligation")
}

// F-02: payroll (только агрегаты — docs/02 §6)
enum PayrollRunStatus {
  DRAFT
  CHECKED
  APPROVED
  PAID
  POSTED
}

model PayrollRun {
  id                         String           @id @default(uuid(7)) @db.Uuid
  tenantId                   String           @map("tenant_id") @db.Uuid
  period                     String // YYYY-MM
  employeeCount              Int              @map("employee_count")
  grossMinor                 BigInt           @map("gross_minor")
  netMinor                   BigInt           @map("net_minor")
  taxesMinor                 BigInt           @map("taxes_minor")
  registerDocumentId         String?          @map("register_document_id") @db.Uuid
  status                     PayrollRunStatus @default(DRAFT)
  checkedAgainstActiveListAt DateTime?        @map("checked_against_active_list_at")
  createdAt                  DateTime         @default(now()) @map("created_at")
  updatedAt                  DateTime         @updatedAt @map("updated_at")
  createdBy                  String?          @map("created_by") @db.Uuid
  updatedBy                  String?          @map("updated_by") @db.Uuid

  @@unique([tenantId, period])
  @@map("payroll_run")
}

// F-06: ежедневный снапшот KPI
model KpiSnapshot {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  date      DateTime @db.Date
  metrics   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, date])
  @@map("kpi_snapshot")
}

// H-01 (ADR-011): правило распознавания контрагента по строке банковской выписки/кассы.
// Импортируется из книги KSP («Маппинг») и пополняется при ручном разборе.
model CounterpartyMatchRule {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  pattern          String // «Наименование из выписки»
  purposePattern   String?  @map("purpose_pattern")
  counterpartyName String   @map("counterparty_name")
  operationType    String?  @map("operation_type")
  expenseArticle   String?  @map("expense_article")
  vendorId         String?  @map("vendor_id") @db.Uuid
  source           String   @default("ksp")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([tenantId, pattern])
  @@index([tenantId])
  @@map("counterparty_match_rule")
}

// ── H-07 (ADR-013): CEO-контур по docs/15-ceo-path.md ──

enum BusinessUnit {
  ROOFTOP
  SENSE48
}

// Постоянные расходы месяца по бизнесам — знаменатель точки безубыточности.
model FixedCost {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  unit        BusinessUnit
  period      String // YYYY-MM
  name        String
  amountMinor BigInt       @map("amount_minor")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  updatedBy   String?      @map("updated_by") @db.Uuid

  @@unique([tenantId, unit, period, name])
  @@map("fixed_cost")
}

// Типовой норматив себестоимости по формату события, % от выручки.
model CostNorm {
  id        String      @id @default(uuid(7)) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  format    EventFormat
  costPct   Int         @map("cost_pct") // 0..100
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@unique([tenantId, format])
  @@map("cost_norm")
}

// Дневная сводка Sense 48: v1 — ручной ввод, v2 — импорт из Altegio.
model SenseDailyStat {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  date            DateTime @db.Date
  visitsPlanned   Int?     @map("visits_planned")
  visitsActual    Int?     @map("visits_actual")
  revenueMinor    BigInt   @default(0) @map("revenue_minor")
  loadPct         Int?     @map("load_pct")
  cancellations   Int      @default(0)
  membershipsSold Int      @default(0) @map("memberships_sold")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedBy       String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, date])
  @@map("sense_daily_stat")
}

// ───────────────────────────── §P MDS Property Core (docs/20) ─────────────────────────────
// Building → Floor → Unit; статусы нормализованы, цвет НЕ хранится (BR-P01, выводится в core).

enum BuildingKind {
  TOWER
  OFFICES
  MALL
  MIXED
}

enum UnitType {
  APARTMENT
  OFFICE
  RETAIL
  PARKING
  STORAGE
  COMMON
  TECHNICAL
}

enum ReadinessStatus {
  READY
  RENOVATION
  FITOUT
  FURNISHING
  BLOCKED
}

enum OccupancyStatus {
  VACANT
  OCCUPIED
  OWNER_USE
  UNAVAILABLE
}

enum RentalMode {
  NONE
  LTR
  STR
}

enum LeaseStatus {
  NONE
  DRAFT
  ACTIVE
  EXPIRING
  TERMINATED
}

enum CommercialStatus {
  OFF_MARKET
  AVAILABLE
  RESERVED
  VIEWING
  NEGOTIATION
  LOI
  CONTRACTED
}

enum OperationalStatus {
  NORMAL
  ISSUE
  CRITICAL
  BLOCKED
}

enum PropertyOwnerKind {
  PERSON
  COMPANY
}

enum UnitActivityKind {
  VIEWING
  CALL
  NOTE
  FOLLOW_UP
  OFFER
}

enum ChangeSource {
  UI
  API
  IMPORT
  AI
}

model Building {
  id              String       @id @default(uuid(7)) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  code            String // TOWER / OFFICES / MALL — стабильный код для импорта
  name            String
  kind            BuildingKind
  address         String?
  geometryVersion Int          @default(1) @map("geometry_version")
  sortOrder       Int          @default(0) @map("sort_order")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  floors Floor[]
  units  Unit[]

  @@unique([tenantId, code])
  @@map("building")
}

model Floor {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  buildingId      String   @map("building_id") @db.Uuid
  floorNo         Int      @map("floor_no")
  name            String?
  // viewBox плана этажа; полигоны юнитов лежат в Unit.geometry в этой системе координат
  planViewBox     String   @default("0 0 1000 600") @map("plan_view_box")
  geometryVersion Int      @default(1) @map("geometry_version")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  building Building @relation(fields: [buildingId], references: [id])
  units    Unit[]

  @@unique([buildingId, floorNo])
  @@index([tenantId, buildingId])
  @@map("floor")
}

// Собственник помещения. Контакты — PII: отдаются только c правом unit.owner.view (BR-P13).
enum OwnerStage {
  LEAD
  CONTACTED
  CALC_SHOWN
  CONSENT
  CONTRACT_SENT
  SIGNED
  HANDED_OVER
  LOST
}

model PropertyOwner {
  id                String            @id @default(uuid(7)) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  kind              PropertyOwnerKind
  displayName       String            @map("display_name")
  contactPhone      String?           @map("contact_phone")
  contactEmail      String?           @map("contact_email")
  managementConsent Boolean           @default(false) @map("management_consent") // согласен на управление платформой
  listingConsent    Boolean           @default(false) @map("listing_consent") // согласен сдавать через платформу
  marketingConsent  Boolean           @default(false) @map("marketing_consent") // согласен на публикацию фото/объявлений
  consentUpdatedAt  DateTime?         @map("consent_updated_at")
  userId            String?           @map("user_id") @db.Uuid // Owner Portal: учётка собственника (роль PROPERTY_OWNER)
  // ст. 28 ЗРУ-581: договор управления письменно c КАЖДЫМ собственником
  managementContractStatus   ManagementContractStatus @default(NONE) @map("management_contract_status")
  managementContractSignedAt DateTime?                @map("management_contract_signed_at") @db.Date
  notes             String?
  // P-22b: воронка собственников (H4) — стадия, следующее действие, менеджер, расчёт показан
  pipelineStage     OwnerStage        @default(LEAD) @map("pipeline_stage")
  stageChangedAt    DateTime?         @map("stage_changed_at")
  nextAction        String?           @map("next_action")
  nextActionAt      DateTime?         @map("next_action_at")
  managerId         String?           @map("manager_id") @db.Uuid
  source            DealSource?
  lostReason        String?           @map("lost_reason")
  calcShownAt       DateTime?         @map("calc_shown_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  units      Unit[]
  mandates   MallMandate[]
  activities UnitActivity[]

  @@unique([tenantId, userId])
  @@index([tenantId, displayName])
  @@index([tenantId, pipelineStage])
  @@map("property_owner")
}

model Unit {
  id                   String            @id @default(uuid(7)) @db.Uuid
  tenantId             String            @map("tenant_id") @db.Uuid
  buildingId           String            @map("building_id") @db.Uuid
  floorId              String            @map("floor_id") @db.Uuid
  unitNo               String            @map("unit_no") // immutable Unit ID (blueprint §5)
  type                 UnitType
  areaM2               Decimal           @map("area_m2") @db.Decimal(10, 2)
  cadastralNumber      String?           @map("cadastral_number") // blueprint §1.7 identity; взносы по кадастру (BR-P51)
  cadastralAreaM2      Decimal?          @map("cadastral_area_m2") @db.Decimal(10, 2)
  geometry             Json? // {points: [[x,y],...]} в planViewBox этажа
  ownerId              String?           @map("owner_id") @db.Uuid
  occupantName         String?           @map("occupant_name") // арендатор/гость (PII-light, без контактов)
  readiness            ReadinessStatus   @default(READY)
  occupancy            OccupancyStatus   @default(VACANT)
  rentalMode           RentalMode        @default(NONE) @map("rental_mode")
  leaseStatus          LeaseStatus       @default(NONE) @map("lease_status")
  commercialStatus     CommercialStatus  @default(OFF_MARKET) @map("commercial_status")
  operationalStatus    OperationalStatus @default(NORMAL) @map("operational_status")
  statusEffectiveAt    DateTime          @default(now()) @map("status_effective_at")
  vacantSince          DateTime?         @map("vacant_since") @db.Date
  leaseEndsAt          DateTime?         @map("lease_ends_at") @db.Date
  askingCurrency       String            @default("USD") @map("asking_currency") @db.Char(3)
  askingRateMinor      BigInt?           @map("asking_rate_minor") // в месяц
  minApprovedRateMinor BigInt?           @map("min_approved_rate_minor")
  monthlyRentMinor     BigInt?           @map("monthly_rent_minor") // по действующему договору
  salePriceMinor       BigInt?           @map("sale_price_minor")
  managedByPlatform    Boolean           @default(false) @map("managed_by_platform")
  publishedAt          DateTime?         @map("published_at")
  notes                String?
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  createdBy            String?           @map("created_by") @db.Uuid
  updatedBy            String?           @map("updated_by") @db.Uuid

  building   Building        @relation(fields: [buildingId], references: [id])
  floor      Floor           @relation(fields: [floorId], references: [id])
  owner      PropertyOwner?  @relation(fields: [ownerId], references: [id])
  activities UnitActivity[]
  leases     LeaseContract[]
  deals      Deal[]
  workOrders WorkOrder[]
  serviceOrders ServiceOrder[]
  rentCharges RentCharge[]
  mandates MallMandate[]
  houseCharges HouseCharge[]

  @@unique([buildingId, unitNo])
  @@index([tenantId, buildingId])
  @@index([tenantId, occupancy, readiness])
  @@index([tenantId, ownerId])
  @@map("unit")
}

// Активность по юниту: показ, звонок, заметка, follow-up, предложение (blueprint §1.11 POST /units/{id}/activities)
model UnitActivity {
  id                String           @id @default(uuid(7)) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  unitId            String?          @map("unit_id") @db.Uuid
  dealId            String?          @map("deal_id") @db.Uuid
  ownerId  String?          @map("owner_id") @db.Uuid
  kind              UnitActivityKind
  note              String
  expectedRateMinor BigInt?          @map("expected_rate_minor")
  followUpAt        DateTime?        @map("follow_up_at") @db.Date
  source            ChangeSource     @default(UI)
  actorId           String           @map("actor_id") @db.Uuid
  happenedAt        DateTime         @default(now()) @map("happened_at")
  createdAt         DateTime         @default(now()) @map("created_at")

  unit  Unit?          @relation(fields: [unitId], references: [id])
  deal  Deal?          @relation(fields: [dealId], references: [id])
  owner PropertyOwner? @relation(fields: [ownerId], references: [id])

  @@index([tenantId, unitId, happenedAt])
  @@index([tenantId, dealId, happenedAt])
  @@index([tenantId, ownerId, happenedAt])
  @@map("unit_activity")
}

// ───────────────────────────── §P2 MDS Property Wave 2 (docs/20 §11, ADR-018) ─────────────────────────────

enum LeaseType {
  LTR
  STR
  OWNER_USE
}

enum LeaseContractStatus {
  DRAFT
  ACTIVE
  EXPIRING
  TERMINATED
}

// Договор аренды — источник истины для occupancy/rentalMode/leaseStatus юнита (юнит — зеркало).
model LeaseContract {
  id               String              @id @default(uuid(7)) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  unitId           String              @map("unit_id") @db.Uuid
  ownerId          String?             @map("owner_id") @db.Uuid
  dealId           String?             @map("deal_id") @db.Uuid
  type             LeaseType
  occupantName     String              @map("occupant_name")
  occupantContact  String?             @map("occupant_contact") // PII: телефон/email, отдаётся по праву
  startAt          DateTime            @map("start_at") @db.Date
  endAt            DateTime?           @map("end_at") @db.Date
  rentMinor        BigInt              @map("rent_minor") // в месяц
  depositMinor     BigInt?             @map("deposit_minor")
  depositReceived  Boolean             @default(false) @map("deposit_received")
  currency         String              @default("USD") @db.Char(3)
  tenantCategory   TenantCategory?     @map("tenant_category") // ТРЦ: состав арендаторов (tenant mix)
  status           LeaseContractStatus @default(DRAFT)
  terminatedAt     DateTime?           @map("terminated_at")
  terminatedReason String?             @map("terminated_reason")
  notes            String?
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  createdBy        String?             @map("created_by") @db.Uuid
  updatedBy        String?             @map("updated_by") @db.Uuid

  unit Unit @relation(fields: [unitId], references: [id])

  rentCharges RentCharge[]

  // partial unique: один ACTIVE/EXPIRING договор на юнит — в migration SQL
  @@index([tenantId, unitId, status])
  @@index([tenantId, status, endAt])
  @@map("lease_contract")
}

enum DealStage {
  NEW
  QUALIFIED
  PROPERTY_SELECTED
  VIEWING
  OFFER
  NEGOTIATION
  LOI
  CONTRACT
  MOVE_IN
  WON
  LOST
}

enum DealSource {
  WEBSITE
  TELEGRAM
  INSTAGRAM
  REFERRAL
  BROKER
  WALK_IN
  OTHER
}

enum DealLostReason {
  PRICE
  TIMING
  LOCATION
  COMPETITOR
  NO_RESPONSE
  OTHER
}

// Сделка CRM (blueprint §6). commercialStatus юнита — производное от активных сделок (BR-P20).
enum ContactKind {
  PERSON
  COMPANY
}

/// CRM Tower (docs/20 §11.14): клиент — один на много сделок; телефон канонический (+digits). PII — по deal.contact.view.
model Contact {
  id          String      @id @default(uuid(7)) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  kind        ContactKind @default(PERSON)
  displayName String      @map("display_name")
  phone       String?
  phoneAlt    String?     @map("phone_alt")
  email       String?
  company     String?
  position    String?
  source      DealSource?
  tags        String[]    @default([])
  notes       String?
  ownerId     String?     @map("owner_id") @db.Uuid // тот же человек — собственник помещения
  managerId   String?     @map("manager_id") @db.Uuid
  lastTouchAt DateTime?   @map("last_touch_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  createdBy   String?     @map("created_by") @db.Uuid
  updatedBy   String?     @map("updated_by") @db.Uuid

  deals Deal[]

  @@unique([tenantId, phone])
  @@index([tenantId, displayName])
  @@index([tenantId, email])
  @@index([tenantId, ownerId])
  @@map("contact")
}

model Deal {
  id                 String          @id @default(uuid(7)) @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  number             String // DEAL-2026-000001
  contactName        String          @map("contact_name") // PII
  contactPhone       String?         @map("contact_phone") // PII
  contactEmail       String?         @map("contact_email") // PII
  contactId    String?    @map("contact_id") @db.Uuid
  company            String?
  source             DealSource      @default(OTHER)
  utm                Json?
  budgetMinor        BigInt?         @map("budget_minor") // в месяц
  areaMinM2          Decimal?        @map("area_min_m2") @db.Decimal(10, 2)
  areaMaxM2          Decimal?        @map("area_max_m2") @db.Decimal(10, 2)
  purpose            String?
  timing             String?
  unitId             String?         @map("unit_id") @db.Uuid
  alternativeUnitIds String[]        @default([]) @map("alternative_unit_ids") @db.Uuid
  managerId          String          @map("manager_id") @db.Uuid
  stage              DealStage       @default(NEW)
  stageChangedAt     DateTime        @default(now()) @map("stage_changed_at")
  nextAction         String?         @map("next_action")
  nextActionAt       DateTime?       @map("next_action_at") @db.Date
  expectedRateMinor  BigInt?         @map("expected_rate_minor")
  reservedUntil      DateTime?       @map("reserved_until") @db.Date
  depositReceived    Boolean         @default(false) @map("deposit_received")
  lostReason         DealLostReason? @map("lost_reason")
  lostNote           String?         @map("lost_note")
  wonLeaseId         String?         @map("won_lease_id") @db.Uuid
  // P-14: продукт сделки → плательщик/база/ставка комиссии (BR-P41); продажа закрывается ценой
  product            DealProduct     @default(LEASE_LTR)
  salePriceMinor     BigInt?         @map("sale_price_minor")
  commissionRateBp   Int?            @map("commission_rate_bp") // переопределение в коридоре продукта
  externalBrokerName String?         @map("external_broker_name")
  externalShareBp    Int             @default(0) @map("external_share_bp") // доля внешнего брокера в комиссии
  tenantCategory     TenantCategory? @map("tenant_category")
  wonAt              DateTime?       @map("won_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  createdBy          String?         @map("created_by") @db.Uuid
  updatedBy          String?         @map("updated_by") @db.Uuid

  unit       Unit?          @relation(fields: [unitId], references: [id])
  contact    Contact?       @relation(fields: [contactId], references: [id])
  activities UnitActivity[]
  commission Commission?
  bonuses    SalesBonus[]
  checklist  DealChecklistItem[]

  @@unique([tenantId, number])
  @@index([tenantId, stage])
  @@index([tenantId, managerId, stage])
  @@index([tenantId, unitId])
  @@index([tenantId, contactId])
  @@map("deal")
}

// Outbox доменных событий (blueprint §1.11): payload без PII; доставка — воркер domain-events.
model DomainEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  type        String // unit.status.changed · lease.activated · lease.terminated · deal.stage.changed
  objectType  String    @map("object_type")
  objectId    String    @map("object_id") @db.Uuid
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  deliveredAt DateTime? @map("delivered_at")
  attempts    Int       @default(0)

  @@index([tenantId, deliveredAt, createdAt])
  @@map("domain_event")
}

// API-ключи тенанта для внешних интерфейсов (сайт, бот): хранится только sha256, plaintext показывается один раз.
model ApiKey {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  prefix     String // первые 8 символов — для идентификации в UI/логах
  keyHash    String    @unique @map("key_hash")
  scopes     String[]  @default([])
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  @@index([tenantId, revokedAt])
  @@map("api_key")
}

// ───────────────────────────── §P3 WorkBot: черновики действий (docs/20 §11.4, blueprint §1.9) ─────────────────────────────

enum ActionDraftStatus {
  DRAFT
  CONFIRMED
  REJECTED
  FAILED
  NEEDS_INFO
}

enum ActionSource {
  WEB
  TELEGRAM
  API
}

// AI/бот только предлагает draft; commit — после подтверждения человеком c правом (structured draft → preview → confirm → commit → audit).
model ActionDraft {
  id          String            @id @default(uuid(7)) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  source      ActionSource      @default(WEB)
  rawText     String            @map("raw_text")
  kind        String? // IntentKind или null, если не распознано
  payload     Json // structured intent (BigInt → string)
  confidence  Int               @default(0) // 0..100
  unitId      String?           @map("unit_id") @db.Uuid
  status      ActionDraftStatus @default(DRAFT)
  preview     String // человекочитаемое «что будет сделано»
  resultRef   String?           @map("result_ref") // ссылка на результат: /property/units/…, /deals/…
  error       String?
  createdBy   String            @map("created_by") @db.Uuid
  confirmedBy String?           @map("confirmed_by") @db.Uuid
  confirmedAt DateTime?         @map("confirmed_at")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([tenantId, status, createdAt])
  @@index([tenantId, createdBy])
  @@map("action_draft")
}

// ───────────────────────────── §P4 Заявки и инциденты (docs/20 §11.5, blueprint §12) ─────────────────────────────

enum WorkOrderCategory {
  PLUMBING
  ELECTRICAL
  HVAC
  CLEANING
  DAMAGE
  ACCESS
  OTHER
}

enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum WorkOrderStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  DONE
  VERIFIED
  CANCELLED
}

// Источник истины operationalStatus юнита (BR-P31). Фото-подтверждения — Document(objectType=work_order).
model WorkOrder {
  id             String            @id @default(uuid(7)) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  number         String // WO-2026-000001
  unitId         String?           @map("unit_id") @db.Uuid
  buildingId     String?           @map("building_id") @db.Uuid
  category       WorkOrderCategory
  priority       WorkOrderPriority @default(NORMAL)
  status         WorkOrderStatus   @default(OPEN)
  title          String
  description    String?
  location       String? // «дверь B2», «ванная» — свободный текст места внутри юнита/здания
  reporterId     String            @map("reporter_id") @db.Uuid
  assigneeId     String?           @map("assignee_id") @db.Uuid
  contractorName String?           @map("contractor_name")
  source         ChangeSource      @default(UI)
  slaDueAt       DateTime          @map("sla_due_at")
  startedAt      DateTime?         @map("started_at")
  doneAt         DateTime?         @map("done_at")
  verifiedAt     DateTime?         @map("verified_at")
  verifiedBy     String?           @map("verified_by") @db.Uuid
  cancelReason   String?           @map("cancel_reason")
  overdueNotifiedAt DateTime?      @map("overdue_notified_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  updatedBy      String?           @map("updated_by") @db.Uuid

  unit Unit? @relation(fields: [unitId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId, status, priority])
  @@index([tenantId, unitId, status])
  @@index([tenantId, assigneeId, status])
  @@map("work_order")
}

// ── §P5 Services marketplace (blueprint §12, docs/20 §11.8) ──

enum ServiceCategory {
  CLEANING
  LAUNDRY
  REPAIR
  CONCIERGE
  MOVING
  DESIGN
  IT
  OTHER
}

enum ServiceProviderKind {
  OWN_OPS // собственная эксплуатация — вся сумма = выручка Operations
  PARTNER // партнёр — платформе комиссия commissionBp
}

enum ServiceOrderStatus {
  NEW
  ACCEPTED
  IN_PROGRESS
  DONE
  VERIFIED
  CANCELLED
}

model ServiceCatalogItem {
  id           String              @id @default(uuid(7)) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  code         String // CLEAN-STD
  name         String
  category     ServiceCategory
  providerKind ServiceProviderKind @map("provider_kind")
  partnerName  String?             @map("partner_name")
  priceMinor   BigInt              @map("price_minor")
  currency     String              @default("UZS") @db.Char(3)
  commissionBp Int                 @default(0) @map("commission_bp") // доля платформы для PARTNER, б.п.
  slaHours     Int                 @default(48) @map("sla_hours")
  description  String?
  active       Boolean             @default(true)
  // P-20 (Services v1.0): условия направления, вовлечение, скидка клиенту, внутренняя ставка за свою эксплуатацию (OPEN)
  terms          ServiceTerms       @default(COMMISSION_PER_ORDER)
  involvement    ServiceInvolvement @default(MANAGED)
  clientDiscountBp Int              @default(0) @map("client_discount_bp")
  ownOpsFeeBp    Int?               @map("own_ops_fee_bp")
  forMall        Boolean            @default(false) @map("for_mall") // арендаторы Mall — не клиенты Services (BR-P48)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  orders   ServiceOrder[]
  packages ServicePackage[]

  @@unique([tenantId, code])
  @@index([tenantId, active, category])
  @@map("service_catalog_item")
}

model ServiceOrder {
  id                String              @id @default(uuid(7)) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  number            String // SO-2026-000001
  catalogItemId     String              @map("catalog_item_id") @db.Uuid
  unitId            String?             @map("unit_id") @db.Uuid
  buildingId        String?             @map("building_id") @db.Uuid
  status            ServiceOrderStatus  @default(NEW)
  // снимок каталога на момент заказа (BR-P35): смена цены/комиссии не меняет существующие заказы
  providerKind      ServiceProviderKind @map("provider_kind")
  partnerName       String?             @map("partner_name")
  priceMinor        BigInt              @map("price_minor")
  currency          String              @db.Char(3)
  commissionBp      Int                 @map("commission_bp")
  quantity          Int                 @default(1)
  // P-20: канал одного окна, профиль клиента, прайс/скидка, трёхуровневый учёт, cost-to-serve, жалоба, пакет
  channel               ServiceChannel       @default(STAFF)
  customerKind          ServiceCustomerKind?  @map("customer_kind")
  listPriceMinor        BigInt?              @map("list_price_minor")
  servicesRevenueMinor  BigInt               @default(0) @map("services_revenue_minor")
  executorRevenueMinor  BigInt               @default(0) @map("executor_revenue_minor")
  handlingMinutes       Int                  @default(0) @map("handling_minutes")
  complaint             Boolean              @default(false)
  complaintNote         String?              @map("complaint_note")
  packageId             String?              @map("package_id") @db.Uuid
  customerName      String?             @map("customer_name") // арендатор/собственник — отображаемое имя
  ordererId         String              @map("orderer_id") @db.Uuid
  ownerId           String?             @map("owner_id") @db.Uuid // заказ собственника (Owner Portal)
  assigneeId        String?             @map("assignee_id") @db.Uuid
  notes             String?
  source            ChangeSource        @default(UI)
  scheduledAt       DateTime            @map("scheduled_at")
  dueAt             DateTime            @map("due_at") // scheduledAt + slaHours
  acceptedAt        DateTime?           @map("accepted_at")
  startedAt         DateTime?           @map("started_at")
  doneAt            DateTime?           @map("done_at")
  verifiedAt        DateTime?           @map("verified_at")
  verifiedBy        String?             @map("verified_by") @db.Uuid
  rating            Int?
  ratingComment     String?             @map("rating_comment")
  cancelReason      String?             @map("cancel_reason")
  overdueNotifiedAt DateTime?           @map("overdue_notified_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  updatedBy         String?             @map("updated_by") @db.Uuid

  catalogItem ServiceCatalogItem @relation(fields: [catalogItemId], references: [id])
  unit        Unit?              @relation(fields: [unitId], references: [id])
  package     ServicePackage?    @relation(fields: [packageId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId, status, dueAt])
  @@index([tenantId, unitId, status])
  @@index([tenantId, ownerId, status])
  @@index([tenantId, catalogItemId])
  @@map("service_order")
}

// ── §P6 Начисление аренды и дебиторка (docs/20 §11.9) ──

enum RentChargeStatus {
  DUE
  PARTIAL
  OVERDUE
  PAID // только по банковской транзакции (BR-P37)
  WAIVED // договор прекращён до периода
}

model RentCharge {
  id                String           @id @default(uuid(7)) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  number            String // RC-2026-000001
  leaseId           String           @map("lease_id") @db.Uuid
  unitId            String           @map("unit_id") @db.Uuid
  ownerId           String?          @map("owner_id") @db.Uuid
  periodStart       DateTime         @map("period_start") @db.Date
  periodEnd         DateTime         @map("period_end") @db.Date
  dueAt             DateTime         @map("due_at") @db.Date
  amountMinor       BigInt           @map("amount_minor")
  receivedMinor     BigInt           @default(0) @map("received_minor") // из ReconciliationMatch(RENT_CHARGE)
  currency          String           @db.Char(3)
  prorated          Boolean          @default(false)
  status            RentChargeStatus @default(DUE)
  paidAt            DateTime?        @map("paid_at")
