{
  "name": "@finance-os/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "prisma generate && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset --force",
    "seed": "tsx seed/index.ts",
    "studio": "prisma studio"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2",
    "prisma": "^6.16.0",
    "tsx": "^4.20.0"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "@finance-os/core": "workspace:*"
  }
}
